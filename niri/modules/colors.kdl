layout {
	background-color "#161313"

    focus-ring {
        active-color "#dfbfbf"
        inactive-color "#4a4645"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#383434"
        inactive-color "#221f1f"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#dfbfbf"
        inactive-color "#968f8f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#dfbfbf80"
    }
}

overview {
	backdrop-color "#161313"
}

recent-windows {
    highlight {
        active-color "#dfbfbf"
        urgent-color "#ffb4ab"
    }
}
