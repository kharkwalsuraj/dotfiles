layout {
	background-color "#151311"

    focus-ring {
        active-color "#d4c5aa"
        inactive-color "#494643"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#373431"
        inactive-color "#211f1d"
        urgent-color   "#ffb4ab"
    }

    shadow { color "#00000070"; }

    tab-indicator {
        active-color   "#d4c5aa"
        inactive-color "#94908c"
        urgent-color   "#ffb4ab"
    }

    insert-hint { color "#d4c5aa80"; }
}

overview { backdrop-color "#151311"; }
recent-windows { highlight { active-color "#d4c5aa"; urgent-color "#ffb4ab"; }; }
