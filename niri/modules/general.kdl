prefer-no-csd
hotkey-overlay { skip-at-startup; hide-not-bound; }
blur { passes 10; offset 3.0; noise 0.02; saturation 1.5; }
cursor { xcursor-theme "Bibata-Modern-Classic"; xcursor-size 24; }
output "eDP-1" { mode "1920x1200@165"; scale 1.5; transform "normal"; }
layer-rule { match namespace="^awww-daemonbackdrop$"; place-within-backdrop true; }


input {
    keyboard { xkb { layout "us"; }; numlock; repeat-delay 250; repeat-rate 35; }
    touchpad { tap; dwt; natural-scroll; click-method "clickfinger"; scroll-factor 0.7; accel-profile "adaptive"; accel-speed 0.0; }
    mouse { accel-profile "adaptive"; accel-speed 0.0; }
    workspace-auto-back-and-forth
}


layout {
    gaps 12
    preset-column-widths { proportion 0.33333; proportion 0.5; proportion 0.66667; proportion 0.8; }
    preset-window-heights { proportion 0.33333; proportion 0.5; proportion 0.66667; proportion 0.8; }
    default-column-width { proportion 0.66667; }
    focus-ring { off; }
    border { on; width 1; }
    shadow { on; softness 30; spread 2; offset x=0 y=4; }
    tab-indicator { hide-when-single-tab; }
}


animations {
    window-open { spring damping-ratio=0.82 stiffness=500 epsilon=0.0001; }
    window-close { spring damping-ratio=0.88 stiffness=900 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=0.80 stiffness=550 epsilon=0.0001; }
    window-movement { spring damping-ratio=0.85 stiffness=650 epsilon=0.0001; }
    window-resize { spring damping-ratio=0.88 stiffness=700 epsilon=0.0001; }
    config-notification-open-close { spring damping-ratio=0.90 stiffness=800 epsilon=0.0001; }
    screenshot-ui-open { spring damping-ratio=0.85 stiffness=750 epsilon=0.0001; }
}
