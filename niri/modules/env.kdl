/*
Niri does not propagate environment variables to systemd services.
Define them in your login shell instead. For example, Bash users can set them in ~/.bash_profile.

#
# ~/.bash_profile
#

# Environment variables
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="kde"
export QT_STYLE_OVERRIDE="Darkly"
export XDG_MENU_PREFIX="plasma-"
export ELECTRON_OZONE_PLATFORM_HINT="auto"

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" && "${XDG_VTNR:-}" == "1" ]]; then
    mkdir -p "$HOME/.cache/niri/"
    niri-session -l > "$HOME/.cache/niri.log" 2>&1
fi

[[ -f ~/.bashrc ]] && . ~/.bashrc
*/

environment {
    // Set a variables for niri session here
    // Remove a variable by using null as the value: DISPLAY null
};
